{
  "name": "@architect-xyz/inference-catalog-react",
  "version": "0.1.0",
  "description": "React components for the logos of the inference catalog: model creators, providers, harnesses and models.",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "logos.d.ts"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./logos/*": { "types": "./logos.d.ts", "import": "./dist/logos/*.js" }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "npm run generate && tsup",
    "typecheck": "npm run generate && tsc --noEmit",
    "test": "npm run generate && vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsup": "8.5.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
