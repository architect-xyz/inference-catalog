{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Provider",
  "description": "A service that serves models: a cloud platform, a model maker's API, an inference cloud, or an exchange.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "type", "logo"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "type": { "enum": ["cloud-platform", "model-maker", "inference-cloud", "exchange"] },
    "logo": { "$ref": "logo.schema.json#/$defs/ref" }
  }
}
