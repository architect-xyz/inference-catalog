{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model",
  "description": "One model identity. Several providers can serve it, each under its own name.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "creator", "kind", "status", "aliases", "logo"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "description": "`<creator id>/<name>`." },
    "name": { "type": "string", "minLength": 1, "description": "The canonical name." },
    "creator": { "type": "string", "description": "A creator id in `creators/`." },
    "kind": {
      "enum": ["chat", "image_generation", "audio_speech", "video_generation", "embedding", "decision", "audio_transcription"]
    },
    "revision": { "type": "string", "description": "The revision, when the registry knows one." },
    "base_model": { "type": "string", "description": "The source of a quantization or LoRA." },
    "status": { "enum": ["APPROVED", "RETIRED"] },
    "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "active"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "active": { "type": "integer", "minimum": 1 }
      }
    },
    "tokenizer": { "type": "string" },
    "references": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "The id of the model in an outside list, by list name."
    },
    "logo": { "$ref": "logo.schema.json#/$defs/ref" }
  }
}
